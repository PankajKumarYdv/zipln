{
  "manifest_version": 3,
  "name": "SaaS URL Shortener",
  "version": "1.0",
  "description": "Quickly shorten URLs from your active tab, context menus, or selected text.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shorten URL"
  }
}
